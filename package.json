{
  "name": "ottomind-icons",
  "private": true,
  "type": "module",
  "description": "ottomind icon set — source icons, build pipeline and packages",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "node scripts/lint.mjs",
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "check": "npm run lint && npm run build && npm run test",
    "new": "node scripts/new-icon.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run check && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
